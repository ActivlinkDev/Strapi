{
  "kind": "collectionType",
  "collectionName": "category_offers",
  "info": {
    "singularName": "category-offer",
    "pluralName": "category-offers",
    "displayName": "Category_Offer",
    "description": "Offer-page copy and damage examples for a taxonomy category, group or sector"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Taxonomy_Name": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "string",
      "required": true
    },
    "Level": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "enumeration",
      "enum": [
        "category",
        "group",
        "sector"
      ],
      "default": "category",
      "required": true
    },
    "Client": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "string"
    },
    "Headline": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string"
    },
    "Intro": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "text"
    },
    "Examples_Heading": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string"
    },
    "Damage_Examples": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "component",
      "repeatable": true,
      "component": "offer.damage-example"
    }
  }
}
